# All credentials stay in the backend. Never use VITE_ variables for secrets.
INTERLOCK_DB_PATH=data/interlock.sqlite3

# Existing Qwen deployment on Akash Console, not the managed AkashML API.
# Use the HTTPS inference service URL ending in /v1 and its own bearer key.
# Do not supply the Console x-api-key deployment-management credential.
# Discover the exact served model alias in the Integrations view.
LLM_PROVIDER=akash_console
LLM_BASE_URL=
LLM_API_KEY=
# Explicit opt-in for a service that does not require bearer authentication.
LLM_ALLOW_UNAUTHENTICATED=false
# HTTP demo mode: only bounded public/synthetic prompts, never keys or private data.
LLM_HTTP_PUBLIC_ONLY=false
AGENT_MODEL=Qwen/Qwen3.8-27B
JUDGE_MODEL=Qwen/Qwen3.8-27B
LLM_TIMEOUT_SECONDS=30
LLM_ENABLE_THINKING=false
# Set false only if your serving engine rejects chat_template_kwargs.
LLM_SEND_THINKING_PARAMETER=true
# Enable only after confirming your serving image supports JSON Schema output.
# Final responses are validated locally regardless of this setting.
LLM_STRUCTURED_OUTPUTS=false

# Autonomous app-owned security agent; sources must be HTTPS on this allowlist.
SECURITY_SOURCE_HOSTS=genai.owasp.org,docs.slack.dev,docs.guild.ai,docs.docker.com,huggingface.co
SECURITY_TICK_SECONDS=5
SECURITY_DEFAULT_INTERVAL_SECONDS=300

# Guild owns the hosted sandbox. No local Docker runtime is required.
SANDBOX_ENABLED=true
# Explicit operator consent to export the sanitized public-source diagnostic payload.
# Private memory, mission, draft bodies, destinations and all credentials are omitted.
GUILD_SANDBOX_EVIDENCE_EXPORT_ENABLED=false
GUILD_SANDBOX_WORKSPACE_ID=
GUILD_SANDBOX_AGENT_ID=
GUILD_SANDBOX_AGENT_VERSION_ID=
GUILD_SANDBOX_ENVIRONMENT=
# Exact environment UUID from Guild environment/runtime records, not its label.
GUILD_SANDBOX_ENVIRONMENT_ID=
GUILD_SANDBOX_IMAGE_ID=
# Local polling deadline only, not an enforced remote execution/spend limit.
GUILD_SANDBOX_TIMEOUT_SECONDS=180
# Publish integrations/guild/incident-investigator as a Goose agent.
# Pin its installed version; disable auto-update. Use a dedicated environment/workspace.
# Set workspace restrict_account_credentials=true, with NO credential associations.
# Actual session-locked runtime metadata and replay output are required for verification.
GUILD_BASE_URL=https://api.guild.ai/v1
GUILD_API_KEY=
# Backend-only API trigger credential (id:secret), issued in Guild's trigger UI.
# This is separate from the account key used for read-only metadata verification.
GUILD_TRIGGER_API_KEY=
GUILD_TRIGGER_ID=

# ClickHouse Cloud uses HTTPS on port 8443 by default.
# Optional local ClickHouse: set port 8123, secure false, and username interlock.
# Empty host keeps remote analytics unavailable without fabricating sponsor use.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=interlock
CLICKHOUSE_SECURE=true

# Optional official Slack MCP: https://mcp.slack.com/mcp (Streamable HTTP).
# Registered internal/Marketplace Slack app, MCP feature enabled, user OAuth chat:write.
# Obtain a user access token through your app's confidential OAuth consent flow.
# A token from the Codex Slack connector is not available to this backend.
# Configure the fixed app ID and approved workspace/channel; never model-provided.
SLACK_MCP_ACCESS_TOKEN=
SLACK_MCP_APP_ID=
SLACK_WORKSPACE_ID=
SLACK_CHANNEL_ID=
# Discover the actual message tool and copy its definition hash before enabling.
# Changed descriptions/schemas block sending until explicitly re-approved.
SLACK_MCP_TOOL_NAME=
SLACK_MCP_TOOL_SCHEMA_HASH=
SLACK_DELIVERY_ENABLED=false
SLACK_TIMEOUT_SECONDS=20
# Recorded demonstrations never send production Slack messages.
# Uncertain outcomes require operator reconciliation; no blind automatic resend.
