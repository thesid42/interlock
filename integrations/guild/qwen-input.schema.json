{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "messages",
    "stream",
    "max_tokens"
  ],
  "properties": {
    "model": {
      "type": "string",
      "enum": [
        "Qwen/Qwen3.8-27B"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 24000
          }
        }
      }
    },
    "stream": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1600
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chat_template_kwargs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable_thinking": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      }
    }
  }
}
